# Cache rules for static assets

/sw.js
  cache-control: no-store, no-cache, must-revalidate

/_next/static/chunks/*
  cache-control: public, max-age=31536000, immutable

/favicon.png
  cache-control: max-age=31536000, immutable

/icon-192.png
  cache-control: max-age=31536000, immutable

/manifest.webmanifest
  cache-control: max-age=31536000, immutable